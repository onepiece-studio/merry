DOMAIN,mcp.exa.ai

# > RevenueCat
DOMAIN,mcp.revenuecat.ai

# > Stripe
DOMAIN,mcp.stripe.com

# > Atlassian (Jira / Confluence)
DOMAIN,mcp.atlassian.com

# > Asana
DOMAIN,mcp.asana.com

# > PayPal
DOMAIN,mcp.paypal.com

# > Vercel
DOMAIN,mcp.vercel.com

# > Neon
DOMAIN,mcp.neon.tech

